rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Global Safety Net: Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Public Item Photos: uploaded by authenticated item reporters
    match /items/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Public Profile Avatars: uploaded by the profile owner
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Private Claim Verification Evidence: restricted to authenticated users
    match /claims/{claimId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
