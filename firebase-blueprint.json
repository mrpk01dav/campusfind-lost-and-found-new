{
  "entities": {
    "Item": {
      "title": "Item",
      "description": "A lost or found item reported on the campus platform",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the item document"
        },
        "type": {
          "type": "string",
          "enum": ["lost", "found"],
          "description": "Whether the item was lost or found"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "description": "Item summary title"
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "description": "Item category classification"
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2000,
          "description": "Detailed description of the item"
        },
        "color": {
          "type": "string",
          "maxLength": 50,
          "description": "Color of the item"
        },
        "location": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150,
          "description": "Campus location where lost or found"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10,
          "description": "Date lost or found (YYYY-MM-DD)"
        },
        "time": {
          "type": "string",
          "maxLength": 20,
          "description": "Time of day (e.g. 14:30 or morning)"
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 1000000,
          "description": "Image URL or data URI of the item photo"
        },
        "handover": {
          "type": "boolean",
          "description": "Whether the item has been handed over to campus security / lost & found desk"
        },
        "status": {
          "type": "string",
          "enum": ["Open", "Possible Match", "Claim Pending", "Recovered", "Closed"],
          "description": "Current lifecycle state of the item"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID of the reporting student/staff"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the reporter"
        },
        "isDemo": {
          "type": "boolean",
          "description": "Flag indicating if this is an administrative sample record"
        },
        "moderationStatus": {
          "type": "string",
          "enum": ["pending", "approved", "flagged", "rejected", "removed"],
          "description": "Moderation status of the listing"
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp of last update"
        }
      },
      "required": [
        "type",
        "title",
        "category",
        "description",
        "location",
        "date",
        "status",
        "ownerId",
        "createdAt"
      ]
    },
    "Claim": {
      "title": "Claim",
      "description": "An ownership claim submitted on a found item",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the claim"
        },
        "itemId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of the target item document"
        },
        "claimantId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID of the claimant"
        },
        "claimantName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the claimant"
        },
        "contactPhone": {
          "type": "string",
          "maxLength": 30,
          "description": "Optional contact phone number for claim verification"
        },
        "details": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500,
          "description": "Private verification details proving ownership"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Under Review", "Approved", "Rejected", "Completed"],
          "description": "Status of the claim review"
        },
        "resolutionNote": {
          "type": "string",
          "maxLength": 500,
          "description": "Reviewer note on the claim resolution"
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["itemId", "claimantId", "details", "status", "createdAt"]
    },
    "AbuseReport": {
      "title": "AbuseReport",
      "description": "A safety or policy violation flag on an item listing",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the report"
        },
        "itemId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of the reported item"
        },
        "reporterId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID of the user reporting the listing"
        },
        "reason": {
          "type": "string",
          "maxLength": 200,
          "description": "Reason category for the report"
        },
        "details": {
          "type": "string",
          "maxLength": 500,
          "description": "Additional context or explanation"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "reviewed", "dismissed", "action_taken"],
          "description": "Moderation status of the report"
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp of creation"
        }
      },
      "required": ["itemId", "reporterId", "reason", "status", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public and account profile for an authenticated campus user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID matching the document key"
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "Email address of the user"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the user"
        },
        "role": {
          "type": "string",
          "enum": ["student", "staff", "moderator", "admin"],
          "description": "User role"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of profile creation"
        }
      },
      "required": ["id", "email", "displayName", "role", "createdAt"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": {
        "$ref": "#/entities/Item"
      },
      "description": "Campus-wide lost and found item listings"
    },
    "/claims/{claimId}": {
      "schema": {
        "$ref": "#/entities/Claim"
      },
      "description": "Ownership claims and proof submitted by claimants"
    },
    "/reports/{reportId}": {
      "schema": {
        "$ref": "#/entities/AbuseReport"
      },
      "description": "Abuse and moderation reports for items"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profiles"
    }
  }
}
