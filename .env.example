# Runtime Configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Firebase Cloud Configuration
# Note: In AI Studio, Firebase is provisioned automatically via firebase-applet-config.json.
# For standalone deployment, you may define standard public client keys:
# VITE_FIREBASE_API_KEY="AIzaSy..."
# VITE_FIREBASE_AUTH_DOMAIN="concise-ground-v01dl.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="concise-ground-v01dl"
# VITE_FIREBASE_STORAGE_BUCKET="concise-ground-v01dl.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="37299026377"
# VITE_FIREBASE_APP_ID="1:37299026377:web:..."
